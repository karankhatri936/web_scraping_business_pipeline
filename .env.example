# =============================================================
# Web Scraping -> Business Data Pipeline - configuration
# Copy this file to `.env` and adjust values as needed.
# There are NO secrets in this project; all values are public
# settings for the scraping demo pipeline.
# =============================================================

# --- Target website (public scraping sandbox, "We love being scraped!") ---
TARGET_BASE_URL=https://books.toscrape.com/

# --- Browser / scraping behaviour ---
# true = run Chromium without a visible window
BROWSER_HEADLESS=true
# Page navigation timeout in seconds
NAVIGATION_TIMEOUT_SECONDS=30
# Politeness delay between page requests, in seconds
REQUEST_DELAY_SECONDS=1.0
# Retry count for failed page loads
PAGE_LOAD_RETRIES=1
# Safety limits (0 = unlimited, not recommended)
MAX_PAGES_PER_CATEGORY=3
MAX_CATEGORIES=8
MAX_PRODUCTS=400
# Check robots.txt before scraping (refuses to scrape disallowed paths)
RESPECT_ROBOTS=true

# --- Output locations (relative to project root, or absolute paths) ---
DB_PATH=data/products.db
OUTPUT_CSV_DIR=output/csv
OUTPUT_EXCEL_DIR=output/excel
# Number of rows for "Top N" report sections
REPORT_TOP_N=10

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Scheduler (only used with: python main.py schedule) ---
SCHEDULE_INTERVAL_MINUTES=60
# 0 = run indefinitely
SCHEDULE_MAX_RUNS=0
